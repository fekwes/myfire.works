# Public site URL — used for SEO metadata, OpenGraph/Twitter cards, sitemap
# and robots. Set this to your deployed origin (e.g. https://onfire.example.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI strategy tips (server-side call to Google Gemini).
# Free API key from https://aistudio.google.com → Get API key.
GEMINI_API_KEY=your-gemini-api-key

# Login + saved plans (Supabase). Both are safe to expose to the browser.
# Find these in Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
